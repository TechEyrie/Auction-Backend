{
  "name": "araq-kahraman-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node --test --env-file-if-exists=.env \"tests/**/*.test.ts\"",
    "test:integration": "node --test --env-file-if-exists=.env \"tests/integration/**/*.test.ts\"",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "listings:backfill-audience": "node --env-file-if-exists=.env scripts/backfill-listing-audience.ts --target=development",
    "indexes": "node --env-file-if-exists=.env scripts/ensure-indexes.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "browser:check": "node scripts/browser-check.mjs",
    "seed:men-women-catalogue": "node --env-file-if-exists=.env scripts/seed-men-women-catalogue.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "imagekit": "^5.2.0",
    "mongodb": "^7.7.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "typescript": "5.8.3"
  }
}
