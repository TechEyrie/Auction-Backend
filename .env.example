# Copy to .env for local development. Never commit a real .env.
# No production secrets belong here or in any frontend NEXT_PUBLIC variable.

# Required: transaction-capable MongoDB (replica set) connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=araq_kahraman

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated explicit origins. Never "*" when credentials are allowed.
CORS_ORIGINS=http://localhost:3000

# Express behind a load balancer: set the number of trusted proxy hops, or false locally.
TRUST_PROXY=false
BODY_LIMIT=1mb

SHUTDOWN_TIMEOUT_MS=10000
IDEMPOTENCY_TTL_HOURS=24

# --- Authentication and sessions (Phase 03) ---
# Sliding idle lifetime and absolute lifetime. Keep-me-signed-in lengthens both.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
SESSION_KEEP_SIGNED_IN_DAYS=30

# Secure cookies default to true when NODE_ENV=production; set explicitly only to override.
# COOKIE_SECURE=true
# Split hosts (Vercel frontend → this API): leave unset (auto SameSite=None when CORS has https://)
# or set COOKIE_SAME_SITE=none. Same-site custom domains: COOKIE_SAME_SITE=lax.
# COOKIE_SAME_SITE=none
# COOKIE_PARTITIONED=true
# COOKIE_DOMAIN=example.com
# Production: list the exact browser origin(s), e.g. https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app

# 32 random bytes, base64. Required for admin MFA enrollment; generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating this value invalidates existing MFA enrollments (they must re-enroll).
# MFA_ENCRYPTION_KEY=

# One-time super-admin bootstrap: npm run admin:bootstrap
# Refuses when an active super_admin already exists, and requires a 12+ character password.
# ADMIN_BOOTSTRAP_TOKEN is required in production (min 16 characters): bootstrapping must be an
# explicit, credentialed act. Never commit real values.
# ADMIN_BOOTSTRAP_NAME=Iris Farah
# ADMIN_BOOTSTRAP_PHONE=+97455550001
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_TOKEN=

# Failed/abusive request budget per client IP, per scope (register/login/forgot/reset).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ATTEMPTS=10

# Public Terms version recorded on accepted registrations.
# LEGAL_TERMS_VERSION=

# --- Media (Phase 04) ---
# Storage is behind an adapter: local filesystem (development) or ImageKit (production).
MEDIA_DRIVER=local
MEDIA_STORAGE_ROOT=var/media
# Must stay unset/`false` in production when using ImageKit. Only for explicit local-disk fallback.
# MEDIA_ALLOW_LOCAL_FILESYSTEM=false

# ImageKit (required when MEDIA_DRIVER=imagekit). Never commit real keys.
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_FOLDER=/araq-kahraman/listings

# Limits are development defaults: the design sources disagree on the attachment count
# (screenshots 15, frontend reference 10), and video is not implemented.
MEDIA_MAX_BYTES=5242880
MEDIA_MAX_FILES_PER_COLLECTION=10
MEDIA_MAX_DIMENSION=6000
